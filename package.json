{
  "name": "ferromax-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Demo de ferretería FerreDemo: tienda, fichas de producto, cuentas y panel de administración.",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve-public.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:security",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:security": "node --test \"tests/security/**/*.test.mjs\"",
    "test:security:rls": "node --test tests/security/rls.integration.test.mjs",
    "test:install": "playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@supabase/supabase-js": "2.118.0"
  }
}
